{
  "name": "redosan-authenticity-cli",
  "version": "1.0.0",
  "description": "CLI for RedoSan Authenticity — digital watermarking, fingerprinting, metadata & timestamp tools",
  "bin": {
    "redosan": "./cli/index.js"
  },
  "scripts": {
    "start": "node cli/index.js",
    "link": "npm link",
    "test": "npm run test:core && npm run test:removal",
    "test:core": "node --test cli/tests/did_test.js cli/tests/fingerprint_test.js cli/tests/watermark_core_test.js cli/tests/forensic_test.js",
    "test:removal": "node cli/tests/remove_watermark_test.js",
    "coverage": "c8 --reporter=text --reporter=lcov node --test cli/tests/did_test.js cli/tests/fingerprint_test.js cli/tests/watermark_core_test.js cli/tests/forensic_test.js && node cli/tests/remove_watermark_test.js",
    "coverage:report": "echo No coverage report available",
    "dom-review": "node cli/tests/dom_check.js",
    "id-forge": "node cli/lib/id_forge.js"
  },
  "keywords": [
    "watermark",
    "fingerprint",
    "hash",
    "c2pa",
    "metadata",
    "timestamp",
    "steganography"
  ],
  "license": "GPL-2.0",
  "dependencies": {
    "acorn": "^8.16.0",
    "canvas": "^3.2.3",
    "commander": "^14.0.3",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "@mapbox/node-pre-gyp": "2.0.3",
    "tar": "7.5.15"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.3.0",
    "globals": "^15.0.0",
    "playwright": "^1.52.0",
    "@axe-core/playwright": "^4.10.1"
  }
}
