# RedoSan Authenticity - environment variable template (SAFE TO COMMIT)
# Copy to .env.local and fill in values for your machine.
# Never put real secrets in this file or in git.

# Directory (relative to project root) that holds local-only secret scripts
# and key material. This folder must never be committed.
# Default: .env  (git-ignored; protected location on disk)
REDOSAN_SECRETS_DIR=.env

# VeraCrypt encrypted container that stores the secrets at rest.
# The container is password-protected; mount it to reach the drive below.
# Example only - replace with your own local path.
REDOSAN_SECRETS_CONTAINER=C:/path/to/container.hc

# Drive letter used to mount the container when secrets are needed.
# Example only - replace with the letter you actually use.
REDOSAN_SECRETS_DRIVE=X:
