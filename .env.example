# RedoSan Authenticity - environment variable template (SAFE TO COMMIT)
# Copy to .env.local and fill in values for your machine.
# Never put real secrets in this file or in git.

# Directory (relative to project root) that holds local-only secrets:
# GitHub App scripts (gh-app-token.cjs, ...) and the private key (.pem).
# Default: .env  (git-ignored; protected location on disk)
REDOSAN_SECRETS_DIR=.env
