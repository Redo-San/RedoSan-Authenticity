{
  "$schema": "https://unpkg.com/jscpd@5/schema.json",
  "ignore": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/**/min/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/dist/**",
    "**/coverage/**",
    "**/reports/**",
    "**/.git/**",
    "**/node_modules/**",
    "**/vendor/**",
    "**/.opencode/**",
    "**/.agents/**",
    "**/agent/**",
    "**/.claude/**",
    "**/skills/**",
    "**/.env/**",
    "**/backstop_data/**",
    "**/certs/**",
    "**/docs/**",
    "**/.lh13/**",
    "**/.lighthouseci/**",
    "**/.playwright-mcp/**",
    "**/.stryker-tmp/**",
    "**/test-results/**",
    "**/tests/**",
    "**/.tools/**",
    "**/package-lock.json",
    "**/i18n-data.js",
    "**/lang/*.js"
  ],
  "threshold": 10,
  "minTokens": 50,
  "minLines": 10,
  "reporters": ["console"],
  "languages": [
    "javascript",
    "css",
    "html",
    "json",
    "markdown",
    "powershell",
    "bash"
  ]
}
