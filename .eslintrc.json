{
  "root": true,
  "env": {
    "es2022": true
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-undef": "off",
    "no-unused-vars": "warn"
  },
  "overrides": [
    {
      "files": ["cli/**", "scripts/**"],
      "env": { "node": true }
    },
    {
      "files": ["sw.js"],
      "env": { "serviceworker": true }
    }
  ]
}